# Copy to apps/api/.env and fill in. The real .env is gitignored.

DATABASE_URL="postgresql://user@localhost:5432/seo_platform?schema=public"

API_PORT=4000
WEB_ORIGIN="http://localhost:3000"

JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Seed accounts
SEED_SUPERADMIN_EMAIL="owner@example.com"
SEED_SUPERADMIN_PASSWORD="change-me"
SEED_DEMO_EMAIL=""
SEED_DEMO_PASSWORD=""

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="seo-platform"
R2_ENDPOINT=""
